# === AIOS Harness: подключение LLM ===
# Скопируйте файл в .env и заполните. Подойдёт любой OpenAI-совместимый эндпоинт:
#   OpenAI    — https://api.openai.com/v1
#   OpenRouter— https://openrouter.ai/api/v1
#   Ollama    — http://localhost:11434/v1
#   vLLM      — http://localhost:8000/v1
AIOS_LLM_BASE_URL=
AIOS_LLM_API_KEY=
# Имя модели НА ВЫБРАННОМ ЭНДПОИНТЕ. id из каталога data/models.json (например
# AI4Chem/ChemLLM-7B-Chat-1_5-DPO) подходит, только если эндпоинт реально её отдаёт.
AIOS_LLM_MODEL=

# === Тюнинг рантайма (необязательно) ===
#AIOS_LLM_TIMEOUT=120
#AIOS_MAX_TOOL_ITERATIONS=8
# Подтверждение человеком перед исполнением инструментов (карточка
# «Утвердить/Отклонить» в чате). По умолчанию ВЫКЛЮЧЕНО (решение от
# 23.09.2026: без подтверждений работало лучше). Чтобы включить —
# перечислите инструменты, например широкий набор:
# write_file, notify, make_document, save_project_card, attach_project_file,
# save_ontology, save_rag, save_agent
#AIOS_APPROVAL_TOOLS=
# Сколько секунд ждать решения (тишина = отказ, безопасная сторона).
#AIOS_APPROVAL_TIMEOUT=55
#AIOS_TOOLS_ROOT=./data
#AIOS_RUNTIME_DIR=./.aios-runtime
# Каталог раздела «Об организации» (profile/metrics/documents .json + objects/).
# По умолчанию — ./data/organization: внутри песочницы инструментов агента
# и публичной статики /data (скачивание документов по прямым ссылкам).
#AIOS_ORGANIZATION_DIR=./data/organization
# Периодичность проходов планировщика скрытых «Контекстов о пользователе»
# (сек; сам контекст для каждого пользователя — не чаще раза в сутки).
#AIOS_USER_CONTEXT_INTERVAL=3600

# === Стартовый администратор ===
# Создаётся один раз при первом старте, пока хранилище пользователей пусто
# (AIOS_RUNTIME_DIR/users). На сервере обязательно задайте собственный пароль —
# значение по умолчанию «1234» известно из открытых исходников. После первого
# входа пароль можно сменить в меню пользователя.
#AIOS_ADMIN_LOGIN=m.kharitonov@csr-nw.ru
#AIOS_ADMIN_PASSWORD=1234

# === Подтверждение e-mail (SMTP) ===
# Регистрация отправляет письмо со ссылкой подтверждения. Пока AIOS_SMTP_HOST
# пуст, работает dev-фолбэк: письмо не отправляется, ссылка печатается в лог.
# Для Яндекса: порт 465 — неявный TLS (AIOS_SMTP_TLS=ssl, по умолчанию);
# порт 587 — AIOS_SMTP_TLS=starttls. Пароль — «пароль приложения» ящика
# (Настройки Яндекса → Безопасность), не основной пароль почты.
#AIOS_SMTP_HOST=smtp.yandex.ru
#AIOS_SMTP_PORT=465
#AIOS_SMTP_USER=user@yandex.ru
#AIOS_SMTP_PASSWORD=application-password-here
#AIOS_SMTP_FROM=user@yandex.ru
#AIOS_SMTP_TLS=ssl
# Публичный адрес сайта — из него строятся ссылки в письмах
# (например, https://ваш-домен или https://IP-адрес).
#AIOS_PUBLIC_BASE_URL=

# === Защита регистрации от ботов ===
# Максимальное число регистраций/повторных писем с одного IP в час.
# 0 — отключить лимит. По умолчанию 10.
#AIOS_REGISTER_RATELIMIT=10

# Домены, регистрация на которые всегда запрещена (через запятую).
# Пример: припаркованные домены, с которых идут фиктивные регистрации
# и bounce-письма. Домены без MX-записи отклоняются и без этого списка.
#AIOS_EMAIL_DOMAIN_BLOCKLIST=ex.com,example.com

# === Химия: IBM RXN for Chemistry ===
# Ретросинтез и предсказание продуктов (инструменты rxn_retrosynthesis /
# rxn_forward). Ключ — в личном кабинете https://rxn.app.accelerate.science
# (Settings → API key; у сервиса лимиты бесплатного тарифа). Пока ключ пуст,
# эти инструменты не регистрируются — остальные химические инструменты
# (RDKit в песочнице, GHS-безопасность PubChem) работают без ключа.
#AIOS_RXN_API_KEY=
# Другой инстанс с REST-API, СОВМЕСТИМЫМ с облачным IBM RXN (те же пути
# /rxn/api/api/v1/retrosynthesis, /predictions): базовый URL вместе с
# /rxn/api/api/v1. ВНИМАНИЕ: официальный self-hosted rxn-sandbox
# (github.com/rxn4chemistry/rxn-sandbox) этим API НЕ совместим — он
# отдаёт предсказания через Jupyter/Python и MCP-сервер; подключается
# отдельной интеграцией (MCP-клиент платформы).
#AIOS_RXN_BASE_URL=

# === Литература: Semantic Scholar ===
# Источник source=semanticscholar в literature_search работает и без ключа,
# но у сервиса лимиты на частоту запросов, а часть сетей он не пускает вовсе
# (ответ 403). Бесплатный ключ поднимает лимит и решает отказ: оформить на
# semanticscholar.org/product/api и вписать сюда.
#AIOS_SEMANTICSCHOLAR_API_KEY=

# === Telegram-бот (тот же чат с агентами и базами знаний) ===
# Токен из @BotFather (/newbot). Пока пуст — бот выключен, эндпоинт
# /api/telegram/webhook отвечает 503, привязка в «Кабинете» работает
# без @username бота.
#AIOS_TG_BOT_TOKEN=
# Секрет вебхука: Telegram присылает его в заголовке
# X-Telegram-Bot-Api-Secret-Token; запросы без него отбрасываются.
# Любая случайная строка, например: openssl rand -hex 16
#AIOS_TG_WEBHOOK_SECRET=
# «1» — long polling (getUpdates) вместо вебхука: локальная разработка
# без публичного HTTPS. Взаимоисключимо с вебхуком — пока вебхук
# установлен, Telegram отвечает 409 и polling останавливается.
#AIOS_TG_POLLING=
# HTTP/HTTPS-прокси для Bot API (http://host:port) — если хостинг режет
# исходящие соединения к api.telegram.org (типично для российских облаков:
# проверяется `curl -m 5 https://api.telegram.org/` на сервере). Для
# socks5:// нужен extras httpx[socks]. Пусто — прямые соединения.
#AIOS_TG_PROXY=
